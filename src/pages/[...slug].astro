---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeInsights from '../components/HomeInsights.astro';
import commentForm from '../../components/comment-form.html?raw';
import routes from '../../docs/routes.json';
import pages from '../data/pages.json';

export function getStaticPaths() {
  return routes.map(({ route }) => ({
    params: { slug: route === '/' ? undefined : route.slice(1, -1) },
    props: { route }
  }));
}

const { route } = Astro.props;
const fragments = import.meta.glob('../fragments/**/*.html', { eager: true, query: '?raw', import: 'default' });
const name = Astro.params.slug ?? 'home';
const fragment = fragments[`../fragments/${name}.html`];
if (typeof fragment !== 'string' || !pages[route]) throw new Error(`Missing page source for ${route}`);
const [before, marker, after] = fragment.split(/(<!-- shared:(?:comment-form|home-insights) -->)/);
---
<SiteLayout route={route} page={pages[route]}>
  <Fragment set:html={before} />
  {marker === '<!-- shared:comment-form -->' && <Fragment set:html={commentForm.trim()} />}
  {marker === '<!-- shared:home-insights -->' && <HomeInsights />}
  {after && <Fragment set:html={after} />}
</SiteLayout>
