<!--
  Copy this file to a new name such as choosing-a-ceramic-coating.html.
  Replace the bracketed text. Duplicate a section when you need another heading.
  For the publishing steps, see “Writing an Insights post” in the repository README.
-->
<main id="ui-main" class="container" tabindex="-1">
  <div class="row ui-content-wrap">
    <div class="ui-content-area ui-content-post col-12 col-lg-9" id="ui-content-area">
      <article class="ui---post post type-post category-p10x-insights">
        <div class="ui-post-inner">
          <a href="/insights/">All Insights</a>
          <h1 class="content-heading">[Article title]</h1>
          <p class="ui-item--date">
            <time datetime="[YYYY-MM-DD]">[Day Month Year]</time> · By [Author]
          </p>

          <div class="ui-item--content clearfix">
            <p class="content-paragraph">[Introduce the reader’s question and what this article will help them decide.]</p>

            <!-- Optional image. Uncomment the figure and use an existing /assets/images/ URL and describe the image.
            <figure class="content-image size-full">
              <img src="[Image URL]" alt="[Describe what the reader can see]" decoding="async">
            </figure>
            -->

            <section>
              <h2 class="content-heading">[Section heading]</h2>
              <p class="content-paragraph">[Explain one point. Add an example or practical detail.]</p>
            </section>

            <p class="content-paragraph">[Finish with the takeaway or the reader’s next step.]</p>
          </div>
        </div>
      </article>

      <div class="comments-area" id="comments">
        <div class="comment-respond" id="respond">
          <h2 class="comment-reply-title" id="reply-title">Leave A Comment</h2>
          <!-- shared:comment-form -->
        </div>
      </div>
    </div>
  </div>
</main>
