# Source-only drafts on hosts still serving the repository root.
RedirectMatch 404 ^/src/content(?:/|$)

# Preserve links to the former service URL.
RedirectMatch 301 ^/tinting/?$ /automotive-window-tint/
RedirectMatch 301 ^/(window-film|window-tint)/?$ /architecture-tint/

# Preserve published blog URLs, including direct index.html bookmarks.
RedirectMatch 301 ^/ppf-cost-malaysia(?:/index\.html|/)?$ /insights/ppf-cost-malaysia/
RedirectMatch 301 ^/tesla-ppf(?:/index\.html|/)?$ /insights/tesla-ppf/
RedirectMatch 301 ^/nano-ceramic-tint(?:/index\.html|/)?$ /insights/nano-ceramic-tint/
RedirectMatch 301 ^/car-coating-price(?:/index\.html|/)?$ /insights/car-coating-price/
RedirectMatch 301 ^/car-coating(?:/index\.html|/)?$ /insights/car-coating/
RedirectMatch 301 ^/ceramic-coating(?:/index\.html|/)?$ /insights/ceramic-coating/
RedirectMatch 301 ^/zeekr-7x-ppf(?:/index\.html|/)?$ /insights/zeekr-7x-ppf/
RedirectMatch 301 ^/best-car-tint-malaysia(?:/index\.html|/)?$ /insights/best-car-tint-malaysia/
RedirectMatch 301 ^/how-long-does-car-window-tinting-take(?:/index\.html|/)?$ /insights/how-long-does-car-window-tinting-take/
RedirectMatch 301 ^/types-of-car-tint(?:/index\.html|/)?$ /insights/types-of-car-tint/
RedirectMatch 301 ^/jpj-tinted-rules-specification(?:/index\.html|/)?$ /insights/jpj-tinted-rules-specification/
RedirectMatch 301 ^/car-tint-price-malaysia(?:/index\.html|/)?$ /insights/car-tint-price-malaysia/
RedirectMatch 301 ^/ppf-thickness(?:/index\.html|/)?$ /insights/ppf-thickness/
RedirectMatch 301 ^/car-tint-malaysia(?:/index\.html|/)?$ /insights/car-tint-malaysia/
RedirectMatch 301 ^/tpu-tph-pvc-ppf-film(?:/index\.html|/)?$ /insights/tpu-tph-pvc-ppf-film/
RedirectMatch 301 ^/how-to-install-ppf(?:/index\.html|/)?$ /insights/how-to-install-ppf/
RedirectMatch 301 ^/pre-cut-vs-hand-cut-ppf-guide(?:/index\.html|/)?$ /insights/pre-cut-vs-hand-cut-ppf-guide/
RedirectMatch 301 ^/best-ppf-film-malaysia(?:/index\.html|/)?$ /insights/best-ppf-film-malaysia/
RedirectMatch 301 ^/ppf-film-types(?:/index\.html|/)?$ /insights/ppf-film-types/
RedirectMatch 301 ^/is-ppf-worth-it(?:/index\.html|/)?$ /insights/is-ppf-worth-it/

# Text compression is lossless; original photo and video files are untouched.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/ld+json application/xml text/xml image/svg+xml font/ttf application/x-font-ttf
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|css|js|json|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|woff2?|ttf|mp4)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "-[a-f0-9]{12}\.css$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
