# Preserve links to the former service URL.
RedirectMatch 301 ^/tinting/?$ /automotive-window-tint/
RedirectMatch 301 ^/(window-film|window-tint)/?$ /architecture-tint/

# Text compression is lossless; original photo and video files are untouched.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/ld+json application/xml text/xml image/svg+xml font/ttf application/x-font-ttf
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|css|js|json|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|woff2?|ttf|mp4)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "-[a-f0-9]{12}\.css$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
